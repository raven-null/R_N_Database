# ============================================================
# R_N_Database .gitignore
#
# ★ 本仓库是公开仓库 ★
# 文档原件与任何密钥永远不进 Git —— 原件只进 Netlify Blobs。
# 一旦误提交，私有文档会永久留在 Git 历史里，只能靠
# git filter-repo 重写历史才能清除（图库项目吃过这个亏）。
# ============================================================

# ---- 依赖 ----
node_modules/
.pnpm-store/
.npm-cache/

# ---- Netlify ----
.netlify/
.ntl
netlify/.netlify/

# ---- ★ 密钥：绝不入库 ----
.env
.env.local
.env.*.local

# ---- ★ 本地开发回退存储（可能含真实资料副本）----
.local-data/

# ---- ★ 资料源目录：原件只进 Blobs，不进 Git ----
inbox/
content/
library/

# ---- 入库过程产生的临时/中间产物 ----
scripts/data/backup-*.json
scripts/data/*.tmp.json
*.ingest-log.json

# ---- 系统与杂项 ----
.DS_Store
Thumbs.db
desktop.ini
*.log
npm-debug.log*

# 截图产物（本地验证用）
.shots/

# ============================================================
# 本地 .env 模板 —— 复制为 .env 后填写（.env 已被 .gitignore 忽略）
#
# 这个文件只服务于【本地脚本】（入库、探测、本地开发）。
# Netlify 线上的环境变量请在 Site settings → Environment variables 里配，
# 两处职责不同，不要混淆。
# ============================================================

# ------------------------------------------------------------
# 一、本机入库用（ingest.mjs 直写 Blobs）
# ------------------------------------------------------------
# 为什么不走 HTTP 上传接口：图库项目评审记录过 base64 上传导致
# 峰值内存放大到 ~55MB（15MB 文件）的问题。直写 Blobs 绕开函数
# 体积限制、base64 放大，并且能批量跑。
SITE_ID=
# Personal Access Token（Netlify → User settings → Applications）
# ★ 这是全站级令牌，只放本地，绝不写进 Netlify 构建环境
NETLIFY_ACCESS_TOKEN=

# ------------------------------------------------------------
# 二、存储模式（重要）
# ------------------------------------------------------------
# local  = 只用本地 .local-data/ 文件存储，绝不碰线上数据（默认）
# remote = 连真实 Netlify Blobs（需要上面两项凭据）
#
# 本地开发默认 local，避免误写生产数据。
# 想在本地预览线上真实资料时，再手动改成 remote。
DOCS_STORE_MODE=local

# ------------------------------------------------------------
# 三、本地访问密码（仅本地开发用；线上在 Netlify UI 里配 ADMIN_TOKEN）
# ------------------------------------------------------------
ADMIN_TOKEN=

# ------------------------------------------------------------
# 四、CORS 白名单（逗号分隔；线上必填博客域名）
# ------------------------------------------------------------
ALLOWED_ORIGIN=https://ravennull.work

# ------------------------------------------------------------
# 五、AI 打标（可选；不填则 AI 功能自动降级为纯规则，不影响其他功能）
# ------------------------------------------------------------
# 沿用图库 ai-proxy 的智谱模式
ZHIPU_API_KEY=
